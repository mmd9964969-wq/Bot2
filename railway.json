{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm ci --ignore-scripts"
  },
  "deploy": {
    "startCommand": "npm run bot",
    "restartPolicyType": "ALWAYS",
    "multiRegionConfig": {
      "asia-southeast1-eqsg3a": {
        "numReplicas": 1
      }
    }
  }
}
